# Next.js & App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth Configuration
AUTH_SECRET=your_32_character_base64_secret_here
NEXTAUTH_URL=http://localhost:3000

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# 1. Main Database: Supabase PostgreSQL (Prisma with Transaction Pooler)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for migrations & schema push (Session Pooler)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase API & Auth Keys (Optional if using Supabase Storage)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# ==============================================================================
# MEDIA STORAGE (CLOUDINARY - Images & Videos)
# ==============================================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# 2. Backup Database: Neon PostgreSQL (Synced every 3 hours)
NEON_BACKUP_DATABASE_URL="postgresql://neondb_owner:[PASSWORD]@[NEON-HOST].aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# AI MODELS & AGENTS
# ==============================================================================
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash
OPENROUTER_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=your_gemini_api_key

TAVILY_API_KEY=tvly-your_tavily_api_key

# ==============================================================================
# BILLING & PAYMENTS
# ==============================================================================
# 1. Paystack (Nigeria - Primary)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_public_key
PAYSTACK_SECRET_KEY=sk_live_your_secret_key
NEXT_PUBLIC_PAYSTACK_BASIC_PLAN=PLN_basic_plan_code
NEXT_PUBLIC_PAYSTACK_PRO_PLAN=PLN_pro_plan_code
NEXT_PUBLIC_PAYSTACK_ADVANCED_PLAN=PLN_advanced_plan_code
NEXT_PUBLIC_PAYSTACK_TEAM_PLAN=PLN_team_plan_code

# 2. OPay Checkout (Nigeria - Alternative)
OPAY_MERCHANT_ID=your_opay_merchant_id
OPAY_SECRET_KEY=your_opay_secret_key

# 3. Stripe (International / Abroad)
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# 4. Global Crypto Gateway - NOWPayments (BTC, ETH, SOL)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret

# ==============================================================================
# SOCIAL MEDIA OAUTH
# ==============================================================================
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_CLIENT_TOKEN=your_x_client_token

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret

THREAD_APP_ID=your_threads_app_id
THREAD_APP_SECRET=your_threads_app_secret

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

SNAPCHAT_CLIENT_ID=your_snapchat_client_id
SNAPCHAT_CLIENT_SECRET=your_snapchat_client_secret

TIKTOK_CLIENT_ID=your_tiktok_client_id
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

YOUTUBE_LINK_API_KEY=your_youtube_api_key
YOUTUBE_VOZ_API_KEY=your_youtube_voz_key
YOUTUBE_LINK_API_KEY_REDIRECT=your_youtube_redirect_key

TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ==============================================================================
# INTEGRATIONS & CHANNELS (Optional)
# ==============================================================================
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id

SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret

NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret

DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

MAILCHIMP_API_KEY=your_mailchimp_api_key

# ==============================================================================
# WEBHOOKS & SECURITY
# ==============================================================================
REDIS_URL=redis://localhost:6379
ROI_WEBHOOK_SECRET=your_webhook_secret_hex
CRON_SECRET=your_cron_secret_token_hex
TOKEN_ENCRYPTION_KEY=your_64_character_hex_master_encryption_key

# ==============================================================================
# SMTP EMAIL SETTINGS
# ==============================================================================
SUPPORT_EMAIL=support@yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="Koraspace <support@yourdomain.com>"